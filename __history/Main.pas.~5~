unit Main;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.WinXPickers, Vcl.StdCtrls,
  Vcl.ExtCtrls;

type
  TForm1 = class(TForm)
    Label1: TLabel;
    Edit1: TEdit;
    Label2: TLabel;
    Label3: TLabel;
    Edit2: TEdit;
    Button1: TButton;
    procedure Button1Click(Sender: TObject);
  private
    { Private-Deklarationen }
  public
    { Public-Deklarationen }
  end;

var
  Form1: TForm1;

implementation

{$R *.dfm}

procedure TForm1.Button1Click(Sender: TObject);
var erreichtePkt, MaxPkt : Integer;
    Prozent: Real;
    Note: String;
begin
erreichtePkt:=StrToInt(Edit1.Text);
MaxPkt:=StrToInt(Edit2.Text);

  if MaxPkt = 0  then
  begin
    raise Exception.Create('Maximale Punktzahl darf nicht 0 sein!');
  end;

  prozent := erreichtePkt / MaxPkt * 100;

case (erreichtePkt / MaxPkt * 100) of
  95..100: note := 'Sehr gut (1+)';
    90..94: note := 'Sehr gut (1)';
    85..89: note := 'Sehr gut (1−)';
    80..84: note := 'Gut (2+)';
    75..79: note := 'Gut (2)';
    70..74: note := 'Gut (2−)';
    65..69: note := 'Befriedigend (3+)';
    60..64: note := 'Befriedigend (3)';
    55..59: note := 'Befriedigend (3−)';
    50..54: note := 'Ausreichend (4+)';
    45..49: note := 'Ausreichend (4)';
    40..44: note := 'Schwach ausreichend (4−)';
    33..39: note := 'Mangelhaft (5+)';
    27..32: note := 'Mangelhaft (5)';
    20..26: note := 'Mangelhaft (5−)';
    0..19:  note := 'Ungenügend (6)';
end;

end;

end.
